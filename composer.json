{
    "name": "aiptu/libplaceholder",
    "description": "A flexible placeholder library for PocketMine-MP plugins, allowing dynamic insertion of player and global data into messages.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "pocketmine/pocketmine-mp": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "aiptu\\libplaceholder\\": "/src/aiptu/libplaceholder"
        }
    },
    "extra": {
        "virion": {
            "namespace-root": "aiptu\\libplaceholder",
            "spec": "3.0"
        }
    }
}
